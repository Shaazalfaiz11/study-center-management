# ============================================================
# Copy this file to .env.local and fill in your Supabase values.
# .env.local is gitignored — never commit real keys.
# ============================================================

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Same page → "anon" / "public" key.
# Safe in the browser: every query it makes is subject to Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Same page → "service_role" key.
# SERVER ONLY. Bypasses every RLS policy. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used to build auth email redirect links.
# Locally: http://localhost:3000
# Production: your deployed URL, e.g. https://study-center-management.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
